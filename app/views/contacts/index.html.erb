<div class="max-w-6xl mx-auto p-6" data-controller="contacts">
  <%= turbo_stream_from "contacts" %>
  <div data-contacts-target="trigger">
    <div id="refresh_trigger"></div>
  </div>

  <div class="flex justify-between mb-2">
    <div class="text-2xl font-bold">
      Contacts list:
      <span data-contacts-target="count">0</span>
    </div>

    <div class="flex items-center gap-4">
      <%= form_with url: contacts_path, method: :get, data: { turbo_frame: "contacts_table", contacts_target: "form" } do |f| %>
        <%= f.select :category,
                     Contact.categories.keys.map { |k| [k.humanize, k] },
                     { include_blank: "All categories" },
                     { class: "px-3 py-2 border",
                       onchange: "this.form.requestSubmit()" } %>
      <% end %>

      <%= link_to "Add contact",
                  new_contact_path,
                  class: "bg-blue-600 text-white px-4 py-2 hover:bg-blue-700" %>
    </div>
  </div>

  <div id="table_container">
    <%= render "table", contacts: @contacts %>
  </div>
</div>
