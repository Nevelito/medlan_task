<tr class="<%= @index.odd? ? 'bg-blue-200' : 'bg-white' %> contact-row">
  <td class="px-4 py-2 border"><%= @contact.name %></td>
  <td class="px-4 py-2 border"><%= @contact.surname %></td>
  <td class="px-4 py-2 border"><%= @contact.email %></td>
  <td class="px-4 py-2 border"><%= @contact.phone.presence || "-" %></td>
  <td class="px-4 py-2 border capitalize"><%= @contact.category %></td>
  <td class="px-4 py-2 border">
    <%= @contact.updated_at.strftime("%Y-%m-%d %H:%M") %>
  </td>
  <td class="px-4 py-2 border whitespace-nowrap">
    <%= link_to "Edit",
                edit_contact_path(@contact),
                data: { turbo_frame: "_top" },
                class: "text-yellow-600 hover:underline mr-2" %>
    <%= button_to "Delete",
                contact_path(@contact),
                method: :delete,
                data: { confirm: "Are you sure?" },
                class: "text-red-600 hover:underline" %>
  </td>
</tr>
